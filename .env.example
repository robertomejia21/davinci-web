# Copia este archivo como .env (local) y carga las mismas variables en
# Vercel → Project → Settings → Environment Variables.
# Son secretas: nunca les pongas el prefijo NEXT_PUBLIC_.

# ---- Green API (demo «Recíbelo en TU WhatsApp») ----
# Todo sale de console.green-api.com → tu instancia:
#   apiUrl            → GREEN_API_URL  (ej. https://7105.api.greenapi.com)
#   idInstance        → GREEN_API_ID_INSTANCE
#   apiTokenInstance  → GREEN_API_TOKEN_INSTANCE
GREEN_API_URL=
GREEN_API_ID_INSTANCE=
GREEN_API_TOKEN_INSTANCE=

# ---- Resend (formulario de contacto) ----
# resend.com → API Keys → crea una con permiso «Sending access».
RESEND_API_KEY=
# Remitente: debe ser del dominio verificado en Resend (da-vinci.ai).
CONTACTO_DE=Da Vinci IA <sitio@da-vinci.ai>
# A quién llegan los mensajes (varios: sepáralos con comas).
CONTACTO_PARA=yo@robertomejiab.com
